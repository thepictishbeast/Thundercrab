<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for IMAP/SMTP/Sieve via the Rust core. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Background IMAP IDLE push: a foreground "data sync" service holds the
         connection open; POST_NOTIFICATIONS surfaces new-mail alerts (API 33+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.plausiden.thundercrab.ThunderCrabApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Thundercrab"
        android:usesCleartextTraffic="false">

        <activity
            android:name="com.plausiden.thundercrab.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Thundercrab">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Background IMAP IDLE watcher. Not exported — started only by the app. -->
        <service
            android:name="com.plausiden.thundercrab.service.IdleService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
